# Copie este arquivo para .env e preencha com seus valores.
# NUNCA versione o .env (ele já está no .gitignore).

# ── Servidor ──────────────────────────────────────────────
PORT=3000
# production em produção (ativa o modo seguro)
NODE_ENV=development
# Segredo das sessões. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Atrás de proxy HTTPS (Easypanel, Render, Nginx...) use 1 para o cookie seguro funcionar
# TRUST_PROXY=1

# ── MongoDB ───────────────────────────────────────────────
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/
MONGO_DB=r2_gallery
MONGO_COLLECTION=images

# ── Cloudflare R2 (armazenamento das fotos) ───────────────
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── Usuário admin criado na primeira execução (banco vazio) ──
ADMIN_USER=admin
ADMIN_PASS=

# ── Acesso por QR Code (login de visitante) ───────────────
# Sem esta chave o botão "Gerar QR Code" mostra erro e /login-qr fica desativado.
# Gere uma chave longa e aleatória:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Para revogar QR Codes já compartilhados, troque a chave e gere um QR novo.
QR_ACCESS_KEY=
